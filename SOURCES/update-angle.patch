+TEST_P(SRGBTextureTestES3, SRGBDecodeTexelFetchWithSamplerInStructPassedToFunctions)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_texture_sRGB_decode"));
