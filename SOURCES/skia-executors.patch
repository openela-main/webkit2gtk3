From c690c2459b6b91cf0bc3f1bb46e12638aba5a5de Mon Sep 17 00:00:00 2001
From: Tomas Popela <tpopela@redhat.com>
Date: Fri, 6 Nov 2026 11:21:59 +0000
Subject: [PATCH] [GTK] Fix build with Skia M157: move to
 SkExecutors::MakeFIFOThreadPool()

Skia M157 moved the FIFO thread pool factories out of the SkExecutor class
into the SkExecutors namespace, declared in the private src/core/SkExecutors.h
header. Include the new header and call SkExecutors::MakeFIFOThreadPool().

* Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp:
---
 Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp b/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
index 22bcc67..772217c 100644
--- a/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
+++ b/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
@@ -32,7 +32,7 @@
 
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
 #include <skia/core/SkColorSpace.h>
-#include <skia/core/SkExecutor.h>
+#include "src/core/SkExecutors.h"
 #include <skia/gpu/ganesh/GrBackendSurface.h>
 #include <skia/gpu/ganesh/SkSurfaceGanesh.h>
 #include <skia/gpu/ganesh/gl/GrGLBackendSurface.h>
@@ -346,7 +346,7 @@ private:
         // lookup which is a slow-path in certain tiled GPUs (such as Vivante/etnaviv). Since we
         // don't use any mipmapping, it's safe to disable that, and avoid performance hits.
         options.fSharpenMipmappedTextures = false;
-        thread_local std::unique_ptr<SkExecutor> s_executor = SkExecutor::MakeFIFOThreadPool(2);
+        thread_local std::unique_ptr<SkExecutor> s_executor = SkExecutors::MakeFIFOThreadPool(2);
         options.fExecutor = s_executor.get();
         if (auto bytes = glyphCacheTextureMaximumBytes())
             options.fGlyphCacheTextureMaximumBytes = *bytes;
